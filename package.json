{
	"name": "stylelint-gamut",
	"version": "2.0.2",
	"description": "Stylelint plugin for working with different color spaces",
	"type": "module",
	"main": "src/index.js",
	"scripts": {
		"format": "prettier --write .",
		"lint": "eslint --fix",
		"test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
		"prepare": "husky install"
	},
	"lint-staged": {
		"*.js": "eslint --fix",
		".": "prettier -write"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fpetrakov/stylelint-gamut.git"
	},
	"files": [
		"src/**/*.js",
		"!**/**/*.test.js"
	],
	"keywords": [
		"stylelint",
		"stylelint-plugin",
		"gamut",
		"lch",
		"oklch",
		"lab",
		"oklab"
	],
	"author": "Fedya Petrakov",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/fpetrakov/stylelint-gamut/issues"
	},
	"homepage": "https://github.com/fpetrakov/stylelint-gamut#readme",
	"peerDependencies": {
		"stylelint": "^14.0.0 || ^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^26.13",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": "^12.18",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-config-standard": "^17.1.0",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-n": "^18.0.1",
		"eslint-plugin-promise": "^7.3.0",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"jest-cli": "^30.4.2",
		"jest-preset-stylelint": "^9.1.0",
		"lint-staged": "^17.0.3",
		"prettier": "^3.8.3",
		"stylelint": "^18.0.0"
	},
	"dependencies": {
		"colorjs.io": "^0.6.1"
	}
}
